# Copy to .env.local. With the demo flag on, the app runs without any key.

# Demo mode uses the committed example sector and synthetic headlines.
# Set it to false only when Supabase is configured.
TRENDWATCH_DEMO_MODE=true

# Active sector slug. Demo reads data/sectors/<slug>.json.
# Supabase reads the sectors row with this slug.
TRENDWATCH_SECTOR_SLUG=renewable-energy

# Supabase project. The anon key is public (read-only by RLS).
# The service role key stays on the server and in GitHub Actions. Never expose it to the browser.
TRENDWATCH_SUPABASE_URL=
TRENDWATCH_SUPABASE_ANON_KEY=
TRENDWATCH_SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini. Only the Python jobs call the model.
TRENDWATCH_GEMINI_API_KEY=
TRENDWATCH_GEMINI_MODEL=gemini-2.5-flash
